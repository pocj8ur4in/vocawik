# Application
APPLICATION_NAME=vocawik
APPLICATION_DESCRIPTION=vocawik REST API
APPLICATION_VERSION=v1

# Server
SERVER_PORT=8080

# Database
DB_PORT=5432
POSTGRES_DB=vocawik
DB_URL=jdbc:postgresql://localhost:${DB_PORT}/${POSTGRES_DB}
DB_USERNAME=
DB_PASSWORD=

# HikariCP
HIKARI_MAX_POOL_SIZE=10
HIKARI_MIN_IDLE=5
HIKARI_CONNECTION_TIMEOUT=30000
HIKARI_IDLE_TIMEOUT=600000
HIKARI_MAX_LIFETIME=1800000

# JWT
JWT_SECRET=
JWT_ISSUER=vocawik
JWT_AUDIENCE=vocawik-api
JWT_ACCESS_EXPIRATION=1800000
JWT_REFRESH_EXPIRATION=604800000

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_AUTH_URI=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_USER_INFO_URI=https://openidconnect.googleapis.com/v1/userinfo
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/oauth/google/callback

# Email verification
EMAIL_VERIFICATION_FRONTEND_URL=http://localhost:5173/register
EMAIL_VERIFICATION_SUBJECT=vocawik 이메일 인증
EMAIL_VERIFICATION_CONTENT_TEMPLATE=아래 링크를 클릭해 이메일 인증을 완료하세요. (유효시간 10분)\n{verifyUrl}\n요청하지 않았다면 이 메일을 무시하세요.

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your@gmail.com
SMTP_APP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS_ENABLE=true
SMTP_FROM=your@gmail.com

# Sentry
SENTRY_DSN=
SENTRY_ENV=local
SENTRY_TRACES_SAMPLE_RATE=0.0
